{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BIR EIS & QuickBooks E-Invoicing System",
  "version": "1.0.0",
  "identifier": "ph.gov.bir.einvoice.quickbooks",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BIR EIS & QuickBooks E-Invoicing System (Philippines Compliance)",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

